generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  password   String
  role       Role      @default(TENANT)
  phone      String?
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  avatar     String?
  bio        String?
  isDisabled Boolean   @default(false)
  isActive   Boolean   @default(true)
  bookings   Booking[]
  houses     House[]
  reports    Report[]
  savedProperties SavedProperty[]
  bookingRequests BookingRequest[]
}

model House {
  id          String        @id @default(cuid())
  title       String
  description String
  price       Int
  location    String
  district    String
  type        PropertyType  @default(HOUSE)
  bedrooms    Int
  bathrooms   Int
  furnished   Boolean       @default(false)
  status      ListingStatus @default(PENDING)
  landlordId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  expiresAt   DateTime?
  floor       Int?
  isFeatured  Boolean       @default(false)
  size        Int?
  viewCount   Int           @default(0)
  category        PropertyCategory   @default(RESIDENTIAL)
  availability    AvailabilityStatus @default(AVAILABLE)
  sector          String?
  landmark        String?
  hasWater        Boolean            @default(true)
  hasElectricity  Boolean            @default(true)
  hasParking      Boolean            @default(false)
  nearMainRoad    Boolean            @default(false)
  nearBusStop     Boolean            @default(false)
  footTraffic     FootTraffic?
  businessAllowed String?
  lat             Float?
  lng             Float?
  views           Int                @default(0)
  whatsappNumber  String?
  lastVerifiedAt  DateTime?
  bookings    Booking[]
  landlord    User          @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  images      HouseImage[]
  reports     Report[]
  savedBy     SavedProperty[]
  bookingRequests BookingRequest[]
}

model HouseImage {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  houseId   String
  createdAt DateTime @default(now())
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
}

model Booking {
  id         String        @id @default(cuid())
  tenantId   String
  houseId    String
  message    String?
  status     BookingStatus @default(PENDING)
  moveInDate DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  phone      String?
  tenantName String?
  tenantPhone String?
  preferredDate DateTime?
  preferredTime String?
  purpose String? @default("LIVING")
  house      House         @relation(fields: [houseId], references: [id], onDelete: Cascade)
  tenant     User          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BookingRequest {
  id            String        @id @default(cuid())
  houseId       String
  house         House         @relation(fields: [houseId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        User          @relation(fields: [tenantId], references: [id])
  tenantName    String
  tenantPhone   String
  preferredDate DateTime
  preferredTime String
  message       String
  purpose       String        @default("LIVING")
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  houseId    String
  reason     String
  details    String?
  resolved   Boolean  @default(false)
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  house      House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}

model SavedProperty {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId   String
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, houseId])
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CONFIRMED
  REJECTED
  COMPLETED
}

enum PropertyType {
  HOUSE
  APARTMENT
  STUDIO
  VILLA
  ROOM
  SHOP
  OFFICE
  WAREHOUSE
  HALL
  RESTAURANT
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
}

enum AvailabilityStatus {
  AVAILABLE
  VISIT_BOOKED
  UNDER_NEGOTIATION
  RENTED
  UNAVAILABLE
}

enum FootTraffic {
  LOW
  MEDIUM
  HIGH
}
